<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Thunderbird.Client</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.29.3" />
    <PackageReference Include="Grpc.Net.Client" Version="2.66.0" />
    <PackageReference Include="Grpc.Tools" Version="2.71.0" PrivateAssets="All" />
    <PackageReference Include="Thunderbird.GameRules" Version="0.1.0" Condition="'$(TB_USE_NUGET_GAMERULES)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="../../../thunderbird-contracts/proto/**/*.proto" ProtoRoot="../../../thunderbird-contracts/proto" GrpcServices="Client" />
  </ItemGroup>

</Project>
